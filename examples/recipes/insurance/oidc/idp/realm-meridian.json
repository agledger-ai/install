{
  "realm": "meridian",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "claims-adjuster",
      "name": "Meridian claims adjuster workload (performer)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "secret": "adjuster-secret-1",
      "protocolMappers": [
        {
          "name": "aud-agledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agledger",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "agledger-scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "agledger_scopes",
            "claim.value": "[\"records:read\", \"records:write\", \"completions:read\", \"completions:write\", \"agents:read\", \"disputes:read\", \"events:read\", \"schemas:read\", \"audit:read\", \"compliance:read\", \"drift:read\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "claims-supervisor",
      "name": "Meridian claims supervisor workload (principal)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "secret": "supervisor-secret-1",
      "protocolMappers": [
        {
          "name": "aud-agledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agledger",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "agledger-scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "agledger_scopes",
            "claim.value": "[\"records:read\", \"records:write\", \"completions:read\", \"completions:write\", \"agents:read\", \"disputes:read\", \"events:read\", \"schemas:read\", \"audit:read\", \"compliance:read\", \"drift:read\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "claims-auditor",
      "name": "Meridian claims auditor workload (read-only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "secret": "auditor-secret-1",
      "protocolMappers": [
        {
          "name": "aud-agledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agledger",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "agledger-scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "agledger_scopes",
            "claim.value": "[\"records:read\", \"audit:read\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "unbound-workload",
      "name": "A workload no agent answers to (negative control)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "secret": "unbound-secret-1",
      "protocolMappers": [
        {
          "name": "aud-agledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agledger",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}