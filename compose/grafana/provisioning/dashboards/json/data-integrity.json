          "expr": "sum by (busEvent) (increase(agledger_persist_event_unmapped_total[1h]))",
          "legendFormat": "{{busEvent}}",
          "refId": "A"
        }
      ],
      "title": "Unmapped bus events (1h) \u2014 agledger_persist_event_unmapped_total",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Parents the consistency sweep settled out of band: every child terminal, no activity for five minutes, so the sweep rolled the parent up. Movement here is NORMAL, not a fault. A parent whose children are all notarize-only has no last-child transition to settle it inline and always settles here; only a parent whose inline rollup was lost to a crash or a dropped cascade job is a real fault, and this panel cannot tell the two apart. Read the GAP instead: stuck rising while repaired stays flat means those parents cannot settle and needs a human. The sweep handles at most 50 parents per five-minute pass, so a large backfill drains at roughly 600 an hour and the two series close over hours rather than minutes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
