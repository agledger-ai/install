      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(agledger_auto_rollup_stuck_parents_total[1h]))",
          "legendFormat": "found due (1h)",
          "refId": "A"
        },
        {
          "datasource": {
