    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Does what leaves this Server arrive, and is anything permanently lost? `dead-lettered` is the one that matters: those jobs exhausted the pg-boss retry budget, so the peer will never receive that projection without an operator redrive from GET /federation/v1/admin/dlq. `post failed` is per-attempt and self-heals through retries, so a rising line there with a flat dead-lettered line is a slow peer, not data loss. `inbound conflict` counts peer projections that collided with a record already here (stale = ours won and theirs was discarded). Replaces a panel that queried agledger_federation_sequence_gaps_total and agledger_federation_sequence_reconciled_total, which no process has ever registered.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
